<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!-- The only project permitted a document-intelligence dependency (spec 016
       B-2). The production adapter calls the approved Canada Central REST API
       2024-11-30 directly, so no DI SDK ships. It needs only Azure.Core:
       Azure.Core 1.54 carries the ManagedIdentityCredential types that
       Azure.Identity 1.21 forwards, so the adapter's own no-retry,
       no-logging user-assigned credential needs no Azure.Identity package,
       which stays pinned only in TaxAI.AzureInfrastructure.

       Microsoft.Extensions.DependencyInjection.Abstractions serves the single
       registration extension, pinned to the repository's 10.0.10 line. -->
  <ItemGroup>
    <PackageReference Include="Azure.Core" Version="1.54.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.10" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ExtractionWorkflow\ExtractionWorkflow.csproj" />
  </ItemGroup>

</Project>
