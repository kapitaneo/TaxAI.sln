<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!-- The ONLY project in this repository that may reference EF Core. Confining
       the ORM here is what makes "tax-domain code must not depend on EF Core" a
       fact about the reference graph rather than a rule someone has to remember.
       One provider, pinned: a second would mean two answers about how a decimal
       column round-trips. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.10" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.10" PrivateAssets="all" GeneratePathProperty="true" />
  </ItemGroup>

  <ItemGroup>
    <None
      Include="$(PkgMicrosoft_EntityFrameworkCore_Design)\lib\net10.0\Microsoft.EntityFrameworkCore.Design.dll"
      Link="Microsoft.EntityFrameworkCore.Design.dll"
      CopyToOutputDirectory="PreserveNewest"
      CopyToPublishDirectory="Never" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ClientIntake\ClientIntake.csproj" />
    <ProjectReference Include="..\ExtractionWorkflow\ExtractionWorkflow.csproj" />
    <ProjectReference Include="..\TaxCases\TaxCases.csproj" />
    <ProjectReference Include="..\Tenancy\Tenancy.csproj" />
  </ItemGroup>

</Project>
