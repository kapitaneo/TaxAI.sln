<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!-- Dependencies point inward, and are exactly these two. Tenancy reads an
       already-assembled AccountantReviewPackage and reuses the engine's
       ParseResult/ValidationError shapes; it declares no package reference at
       all, because a deterministic module that acquires an ORM, a web stack, or
       a cloud SDK has stopped being deterministic. -->
  <ItemGroup>
    <ProjectReference Include="..\CaseReview\CaseReview.csproj" />
    <ProjectReference Include="..\TaxLogicEngine\TaxLogicEngine.csproj" />
  </ItemGroup>

</Project>
