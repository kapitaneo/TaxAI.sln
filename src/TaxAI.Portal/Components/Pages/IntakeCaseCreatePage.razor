@using Microsoft.AspNetCore.Components.Forms
@using TaxAI.Portal.Components.Layout

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Create intake case | TaxAI</title>
    <link rel="stylesheet" href="/portal.css" />
    <link rel="stylesheet" href="/intake.css" />
    <link rel="stylesheet" href="/TaxAI.Portal.styles.css" />
</head>
<body>
<LayoutView Layout="typeof(PortalLayout)">
    <p class="topline">Client intake</p>
    <h1>Create a 2025 intake case</h1>
    <p class="lede">Choose the expected document slots. The secure client link is shown once after creation.</p>

    <form method="post" action="/intake-cases" class="intake-form">
        <AntiforgeryToken />
        <input type="hidden" name="taxYear" value="2025" />

        <label for="primary-name">Taxpayer display name</label>
        <input id="primary-name"
               name="primaryTaxpayerDisplayName"
               type="text"
               autocomplete="off"
               maxlength="200"
               required />

        <label for="t4-count">Expected T4 documents</label>
        <input id="t4-count"
               name="expectedT4Count"
               type="number"
               min="0"
               max="25"
               value="1"
               required />

        <label for="medical-count">Expected medical-expense documents</label>
        <input id="medical-count"
               name="expectedMedicalExpenseCount"
               type="number"
               min="0"
               max="25"
               value="0"
               required />

        <button type="submit">Create intake case</button>
    </form>
</LayoutView>
</body>
</html>
