@using Microsoft.AspNetCore.Components.Forms
@using TaxAI.Portal.Components.Layout

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Development sign-in | TaxAI</title>
    <link rel="stylesheet" href="/portal.css" />
    <link rel="stylesheet" href="/intake.css" />
    <link rel="stylesheet" href="/TaxAI.Portal.styles.css" />
</head>
<body>
<LayoutView Layout="typeof(PortalLayout)">
    <p class="topline">Local development</p>
    <h1>Development sign-in</h1>
    <p class="lede">Signs in the one synthetic development accountant. This page exists only on a local Development host and must never be used with real taxpayer documents.</p>

    <form method="post" action="/development/sign-in" class="intake-form">
        <AntiforgeryToken />
        <button type="submit">Sign in as the development accountant</button>
    </form>
</LayoutView>
</body>
</html>
