<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!-- The portal's entire package surface: exactly one reference, at an exactly
       pinned version.

       OpenID Connect is the one protocol handler that is NOT in the
       Microsoft.AspNetCore.App shared framework, so authentication cannot be
       reached without it. Everything else this host needs — cookies,
       authorization, data protection — is already in the framework and stays
       out of this file.

       The version is pinned exactly rather than floated. A floating range on
       the component that validates identity tokens means the code that decides
       who a caller is can change between two builds of the same commit. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" Version="10.0.10" />
  </ItemGroup>

  <!-- Dependencies point inward. Persistence owns
       the ORM and exposes one registration extension, which is why adding
       storage to this host adds no ORM package to this file. ExtractionWorkflow
       supplies the accountant use cases and DocumentIntelligence supplies the
       deterministic Development adapter; both references are consumed by the
       composition root and the extraction-only browser projection. -->
  <ItemGroup>
    <ProjectReference Include="..\CaseProcessing\CaseProcessing.csproj" />
    <ProjectReference Include="..\ClientIntake\ClientIntake.csproj" />
    <ProjectReference Include="..\DocumentIntelligence\DocumentIntelligence.csproj" />
    <ProjectReference Include="..\ExtractionWorkflow\ExtractionWorkflow.csproj" />
    <ProjectReference Include="..\Persistence\Persistence.csproj" />
    <ProjectReference Include="..\TaxLogicEngine\TaxLogicEngine.csproj" />
    <ProjectReference Include="..\Tenancy\Tenancy.csproj" />
  </ItemGroup>

</Project>
